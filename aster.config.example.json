{
  "ignore_patterns": [
    ".git/",
    ".aster/",
    ".venv/",
    "node_modules/",
    "__pycache__/",
    ".pytest_cache/",
    "assistant_app/",
    "data/",
    ".env",
    "*.env",
    "*.db",
    "*.db-*",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.pdf",
    "*.bin",
    "*.onnx"
  ],
  "max_file_bytes": 48000,
  "max_total_prompt_bytes": 220000,
  "default_mode": "browser",
  "browser_mode_enabled": true,
  "api_mode_enabled": false,
  "chatgpt_url": "https://chatgpt.com/",
  "browser_launch_timeout_seconds": 45,
  "browser_strategy": "patch_runner",
  "thread_reuse_enabled": false,
  "thread_registry_path": ".aster/thread_registry.json",
  "verification_level": "basic",
  "log_screenshots": false,
  "max_recovery_attempts": 3,
  "visual_action_trace_enabled": false,
  "visual_action_trace_dir": ".aster/visual_trace",
  "visual_action_memory_enabled": true,
  "visual_action_memory_path": ".aster/visual_region_memory.json",
  "visual_action_trace_checkpoint_interval_seconds": 15,
  "visual_action_trace_max_checkpoints_per_key": 2,
  "runtime_log_heartbeat_push_enabled": false,
  "runtime_log_heartbeat_interval_seconds": 30,
  "runtime_log_heartbeat_branch_only": true,
  "preferred_model": "gpt-4o-mini",
  "openai_api_key_env": "OPENAI_API_KEY",
  "auto_apply": false,
  "git_integration": true,
  "auto_commit_and_push": true,
  "push_runtime_logs_after_plan": true,
  "auto_commit_message_prefix": "Aster update",
  "git_remote_name": "origin",
  "sync_with_remote": true,
  "dry_run": true,
  "approval_required_for_destructive": true,
  "approval_required_for_commands": true,
  "history_limit": 8,
  "log_dir": ".aster"
}
